{
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=CrmDatabase.db",
        "AzureConnection": "YOUR_AZURE_SQL_CONNECTION_STRING_WILL_BE_SET_IN_AZURE_PORTAL"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "AllowedHosts": "*",
    "IdentityOptions": {
        "SignIn": {
            "RequireConfirmedAccount": false
        },
        "Password": {
            "RequireDigit": false,
            "RequireLowercase": false,
            "RequireUppercase": false,
            "RequireNonAlphanumeric": false,
            "RequiredLength": 3
        }
    }
}
